# Copy to .env on the utility VM, then chmod 600 .env.
ANYLIST_EMAIL=you@example.com
ANYLIST_PASSWORD=replace-with-your-password

# Optional legacy single-recipe selector; unused by the full backup.
ANYLIST_RECIPE_ID=

# Optional HTTPS endpoint for minimal failure events. It receives only service,
# event type, and timestamp—never credentials, tokens, recipe data, or errors.
ANYLIST_FAILURE_WEBHOOK=

# Optional Brevo transactional email: disabled (default), enabled (failures-only),
# failures-only, or every-run. Environment variables override .env values.
ANYLIST_EMAIL_NOTIFICATIONS=disabled
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME="AnyList Backup"
BREVO_RECIPIENT_EMAIL=you@example.com
# Optional; cron's environment takes precedence when set there.
ANYLIST_RUN_CONVERSIONS=0
